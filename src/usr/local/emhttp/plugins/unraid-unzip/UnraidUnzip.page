<script>
function uuzToggleAdvanced(head) {
  var body = document.getElementById('uuz_advanced');
  if (!body) return;
  var open = body.style.display !== 'none';
  body.style.display = open ? 'none' : 'block';
  head.querySelector('.right i').className = open ? 'fa fa-angle-down' : 'fa fa-angle-up';
}
document.getElementById('uuz_advanced_head').addEventListener('keydown', function (e) {
  if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); uuzToggleAdvanced(this); }
});
(function () {
  var form = document.getElementById('unraid-unzip-settings');
  var status = document.getElementById('unraid-unzip-status');
  if (!form || !status) return;
  form.addEventListener('submit', function (event) {
    event.preventDefault();
    status.textContent = 'Saving...';
    var data = new FormData(form);
    var payload = new URLSearchParams();
    payload.set('action', 'save');
    payload.set('csrf_token', data.get('csrf_token') || '');
    // booleans: only send the key when checked (unchecked = "no")
    var booleans = { 'PRESERVE_SYMLINKS': false, 'WARN_SUSPICIOUS_PATHS': false, 'NOTIFY_ON_COMPLETE': false };
    form.querySelectorAll('input[type="checkbox"]').forEach(function (cb) {
      if (cb.name in booleans) booleans[cb.name] = cb.checked;
    });
    data.forEach(function (value, key) {
      if (key === 'csrf_token' || key === '#file') return;
      if (typeof value !== 'string') return;
      payload.append(key, value);
    });
    payload.set('PRESERVE_SYMLINKS', booleans.PRESERVE_SYMLINKS ? 'yes' : 'no');
    payload.set('WARN_SUSPICIOUS_PATHS', booleans.WARN_SUSPICIOUS_PATHS ? 'yes' : 'no');
    payload.set('NOTIFY_ON_COMPLETE', booleans.NOTIFY_ON_COMPLETE ? 'no' : 'yes');
    fetch('/plugins/unraid-unzip/include/api.php', {
      method: 'POST',
      credentials: 'same-origin',
      headers: {'Content-Type': 'application/x-www-form-urlencoded'},
      body: payload
    }).then(function (response) {
      return response.json();
    }).then(function (result) {
      if (!result.ok) throw new Error(result.error && result.error.message ? result.error.message : 'Could not save settings');
      status.textContent = 'Saved.';
      setTimeout(function () { location.reload(); }, 400);
    }).catch(function (error) {
      status.textContent = 'Error: ' + error.message;
    });
  });
})();
</script>
